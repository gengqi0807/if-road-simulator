# Frontend mode: demo (default) or live
VITE_DATA_MODE=demo

# Zhihu Hackathon OAuth (server-side only in production)
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/zhihu/callback
ZHIHU_ACCESS_SECRET=

# Zhihu LLM provider (fill according to the event console)
ZHIHU_LLM_BASE_URL=
ZHIHU_LLM_API_KEY=
ZHIHU_LLM_MODEL=
